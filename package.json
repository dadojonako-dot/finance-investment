{
  "name": "finance-investment",
  "version": "0.4.0-pilot.1",
  "private": true,
  "description": "Финансы и инвестиция — financial ledger, trading and investment accounting platform",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node prisma/seed.mjs",
    "db:studio": "prisma studio",
    "pilot:setup": "node scripts/check-env.mjs && prisma generate && prisma migrate deploy && node prisma/seed.mjs",
    "pilot:check": "node scripts/check-env.mjs && prisma validate && prisma generate && npm run typecheck && npm test && npm run build",
    "db:migrate:dev": "prisma migrate dev",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.tests.json && node --test test-results/compiled/tests/*.test.js",
    "test:acceptance": "node scripts/acceptance.mjs",
    "db:backup": "node scripts/db-backup.mjs backup",
    "db:restore": "node scripts/db-backup.mjs restore",
    "test:backup": "node scripts/backup-acceptance.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "jose": "6.2.12",
    "lightweight-charts": "5.2.1",
    "next": "16.3.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prisma": "6.19.3",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
