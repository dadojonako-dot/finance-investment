generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  OWNER
  ADMIN
  FINANCE
  TRADER
  ACCOUNTANT
  VIEWER
}
enum LedgerStatus {
  ACTIVE
  ARCHIVED
}
enum AssetType {
  FIAT
  CRYPTO
}
enum AccountType {
  CASH
  BANK
  BANK_CARD
  E_WALLET
  CRYPTO_WALLET
  EXCHANGE_SPOT
  EXCHANGE_FUTURES
  OTHER
}
enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  FX_EXCHANGE
  INVESTMENT
  INVESTMENT_RETURN
  COMMISSION
  ADJUSTMENT
}
enum TradeSide {
  BUY
  SELL
}
enum FuturesSide {
  LONG
  SHORT
}
enum MarginMode {
  CROSS
  ISOLATED
}
enum TradeStatus {
  OPEN
  CLOSED
  CANCELLED
}
enum ProjectStatus {
  PLANNED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}
enum ExchangeProvider {
  BINANCE
  BYBIT
}
enum ExchangeConnectionStatus {
  ACTIVE
  DISABLED
  ERROR
}
model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  sessionVersion Int @default(0)
  name String
  role Role @default(VIEWER)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  transactions Transaction[]
  auditLogs AuditLog[]
}
model Asset {
  id String @id @default(cuid())
  code String @unique
  name String
  type AssetType
  decimals Int @default(2)
  isActive Boolean @default(true)
  accounts Account[]
}
model Ledger {
  id String @id @default(cuid())
  name String
  description String?
  baseCurrency String @default("USD")
  status LedgerStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  accounts Account[]
  transactions Transaction[]
  spotTrades SpotTrade[]
  futuresTrades FuturesTrade[]
  exchangeConnections ExchangeConnection[]
}
model Account {
  id String @id @default(cuid())
  ledgerId String
  ledger Ledger @relation(fields:[ledgerId],references:[id])
  name String
  type AccountType
  assetId String
  asset Asset @relation(fields:[assetId],references:[id])
  openingBalance Decimal @default(0) @db.Decimal(30,10)
  bankName String?
  accountNumber String?
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  transactions Transaction[]
  @@index([ledgerId])
  @@index([assetId])
}
model Transaction {
  id String @id @default(cuid())
  ledgerId String
  accountId String
  ledger Ledger @relation(fields:[ledgerId],references:[id])
  account Account @relation(fields:[accountId],references:[id])
  type TransactionType
  assetCode String
  amount Decimal @db.Decimal(30,10)
  usdRate Decimal? @db.Decimal(30,10)
  usdAmount Decimal? @db.Decimal(30,2)
  operationDate DateTime
  counterparty String?
  projectId String?
  project Project? @relation(fields:[projectId],references:[id])
  category String?
  description String?
  documentRef String?
  transferGroupId String?
  createdById String
  createdBy User @relation(fields:[createdById],references:[id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([ledgerId,operationDate])
  @@index([accountId,operationDate])
  @@index([projectId,operationDate])
  @@index([transferGroupId])
}
model FxExchange {
  id String @id @default(cuid())
  fromTransactionId String @unique
  toTransactionId String @unique
  fromAsset String
  toAsset String
  fromAmount Decimal @db.Decimal(30,10)
  toAmount Decimal @db.Decimal(30,10)
  exchangeRate Decimal @db.Decimal(30,10)
  fee Decimal @default(0) @db.Decimal(30,10)
  operationDate DateTime
  notes String?
}
model SpotTrade {
  id String @id @default(cuid())
  ledgerId String
  ledger Ledger @relation(fields:[ledgerId],references:[id])
  exchangeAccountId String
  symbol String
  side TradeSide
  quantity Decimal @db.Decimal(30,10)
  price Decimal @db.Decimal(30,10)
  fee Decimal @default(0) @db.Decimal(30,10)
  realizedPnl Decimal? @db.Decimal(30,2)
  tradeDate DateTime
  notes String?
  createdAt DateTime @default(now())
  @@index([ledgerId,tradeDate])
}
model FuturesTrade {
  id String @id @default(cuid())
  ledgerId String
  ledger Ledger @relation(fields:[ledgerId],references:[id])
  exchangeAccountId String
  symbol String
  side FuturesSide
  marginMode MarginMode
  leverage Decimal @db.Decimal(10,2)
  quantity Decimal @db.Decimal(30,10)
  entryPrice Decimal @db.Decimal(30,10)
  exitPrice Decimal? @db.Decimal(30,10)
  markPrice Decimal? @db.Decimal(30,10)
  liquidationPrice Decimal? @db.Decimal(30,10)
  margin Decimal @db.Decimal(30,2)
  funding Decimal @default(0) @db.Decimal(30,10)
  fees Decimal @default(0) @db.Decimal(30,10)
  realizedPnl Decimal? @db.Decimal(30,2)
  status TradeStatus @default(OPEN)
  openedAt DateTime
  closedAt DateTime?
  notes String?
  createdAt DateTime @default(now())
  @@index([ledgerId,openedAt])
}
model Project {
  id String @id @default(cuid())
  name String
  description String?
  status ProjectStatus @default(PLANNED)
  isGeneral Boolean @default(false)
  startDate DateTime?
  endDate DateTime?
  targetAmount Decimal? @db.Decimal(30,2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  transactions Transaction[]
}
model AuditLog {
  id String @id @default(cuid())
  userId String?
  user User? @relation(fields:[userId],references:[id])
  entityType String
  entityId String
  action String
  oldValue Json?
  newValue Json?
  createdAt DateTime @default(now())
  @@index([entityType,entityId])
  @@index([createdAt])
}
model ExchangeConnection {
  id String @id @default(cuid())
  ledgerId String
  ledger Ledger @relation(fields:[ledgerId],references:[id])
  provider ExchangeProvider
  name String
  apiKeyEncrypted String
  apiSecretEncrypted String?
  apiPassphraseEncrypted String?
  readOnly Boolean @default(true)
  spotEnabled Boolean @default(true)
  futuresEnabled Boolean @default(true)
  status ExchangeConnectionStatus @default(ACTIVE)
  lastSyncAt DateTime?
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([ledgerId])
  @@index([provider])
}
